################################################################################
# Terraform
################################################################################

# Local .terraform directories (downloaded providers + modules)
.terraform/

# Terraform state files — never commit these
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# tfvars files may contain secrets (keys, passwords, account IDs)
*.tfvars
*.tfvars.json

# Override files are for local customisation only
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Transient lock file created during apply
.terraform.tfstate.lock.info

# Plan output files
*.tfplan
tfplan

# CLI configuration files
.terraformrc
terraform.rc

################################################################################
# Kubernetes / Helm
################################################################################

# kubeconfig files — contain cluster credentials
kubeconfig
kubeconfig.*
*.kubeconfig
.kube/

# Helm chart cache and temporary files
*.tgz
charts/

################################################################################
# AWS
################################################################################

# AWS credentials and config — should never be committed
.aws/
aws-credentials
credentials

################################################################################
# OS / Editor
################################################################################

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# VSCode
.vscode/
*.code-workspace

# JetBrains IDEs
.idea/
*.iml

# Vim / Emacs swap files
*.swp
*.swo
*~

################################################################################
# Logs and temporary files
################################################################################

*.log
*.tmp
*.bak
tmp/
temp/
